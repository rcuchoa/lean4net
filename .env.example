# Copie para .env e preencha antes de rodar `docker compose up`.
# O docker-compose.yml carrega este arquivo automaticamente.

# Credenciais da Anthropic -- opcional para subir os containers, mas
# obrigatoria para `POST /api/generate` (etapa 1) funcionar de verdade.
ANTHROPIC_API_KEY=

# Login do webapp -- as tres sao obrigatorias, o container recusa subir
# sem elas (ver backend/webapp/auth.py).
#
# ATENCAO com LEAN4NET_ADMIN_PASSWORD_HASH: o hash sempre contem `$`
# (formato scrypt do werkzeug), e o Docker Compose interpreta `$` dentro
# de valores do .env como inicio de variavel -- sem escapar, o hash e
# cortado/corrompido silenciosamente. Gere JA escapado (`$` -> `$$`) com:
#   docker compose run --rm cli python3 backend/webapp/hash_password.py 'sua-senha' | sed 's/\$/$$/g'
# e cole o resultado direto, sem editar.
LEAN4NET_ADMIN_USER=admin
LEAN4NET_ADMIN_PASSWORD_HASH=
LEAN4NET_SECRET_KEY=

# Opcionais -- so para o lean-api (default: 10s / 100000 caracteres).
LEAN_API_TIMEOUT=10
LEAN_API_MAX_CODE_SIZE=100000
